From e208b74e2891f0f3aede725aeada349281c249e0 Mon Sep 17 00:00:00 2001
From: berndreiss <bd_reiss@gmx.at>
Date: Tue, 22 Sep 2026 22:43:17 +0200
Subject: [PATCH] Simple nano second pass

---
 src/backend/utils/activity/pgstat_database.c | 4 ++--
 src/backend/utils/activity/pgstat_io.c       | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/backend/utils/activity/pgstat_database.c b/src/backend/utils/activity/pgstat_database.c
index 7f3bc01..880b101 100644
--- a/src/backend/utils/activity/pgstat_database.c
+++ b/src/backend/utils/activity/pgstat_database.c
@@ -349,8 +349,8 @@ pgstat_update_dbstats(TimestampTz ts)
 	 */
 	dbentry->xact_commit += pgStatXactCommit;
 	dbentry->xact_rollback += pgStatXactRollback;
-	dbentry->blk_read_time += pgStatBlockReadTime;
-	dbentry->blk_write_time += pgStatBlockWriteTime;
+	dbentry->blk_read_time += (double) pgStatBlockReadTime / 1000;
+	dbentry->blk_write_time += (double) pgStatBlockWriteTime / 1000;
 
 	if (pgstat_should_report_connstat())
 	{
diff --git a/src/backend/utils/activity/pgstat_io.c b/src/backend/utils/activity/pgstat_io.c
index 8ec1aad..00d52de 100644
--- a/src/backend/utils/activity/pgstat_io.c
+++ b/src/backend/utils/activity/pgstat_io.c
@@ -125,7 +125,7 @@ pgstat_count_io_op_time(IOObject io_object, IOContext io_context, IOOp io_op,
 		{
 			if (io_op == IOOP_WRITE || io_op == IOOP_EXTEND)
 			{
-				pgstat_count_buffer_write_time(INSTR_TIME_GET_MICROSEC(io_time));
+				pgstat_count_buffer_write_time(INSTR_TIME_GET_NANOSEC(io_time));
 				if (io_object == IOOBJECT_RELATION)
 					INSTR_TIME_ADD(pgBufferUsage.shared_blk_write_time, io_time);
 				else if (io_object == IOOBJECT_TEMP_RELATION)
@@ -133,7 +133,7 @@ pgstat_count_io_op_time(IOObject io_object, IOContext io_context, IOOp io_op,
 			}
 			else if (io_op == IOOP_READ)
 			{
-				pgstat_count_buffer_read_time(INSTR_TIME_GET_MICROSEC(io_time));
+				pgstat_count_buffer_read_time(INSTR_TIME_GET_NANOSEC(io_time));
 				if (io_object == IOOBJECT_RELATION)
 					INSTR_TIME_ADD(pgBufferUsage.shared_blk_read_time, io_time);
 				else if (io_object == IOOBJECT_TEMP_RELATION)
-- 
2.43.0

