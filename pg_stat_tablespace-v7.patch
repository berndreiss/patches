+----------------------
+ 
+(1 row)
+
+SELECT stats_reset >= :'ts_reset_before'::timestamptz FROM pg_stat_tablespace
+  WHERE tablespace_name = 'pg_default';
+ ?column? 
+----------
+ t
+(1 row)
